{
  "name": "oghenero82/cement-app",
  "description": "Cement dealer operations, local SQL and MetaForge adapter",
  "license": "MIT",
  "type": "project",
  "homepage": "https://github.com/oghenero82/cementApp",
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.7",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-sqlite3": "*",
    "ext-fileinfo": "*",
    "ext-curl": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit"
  }
}
