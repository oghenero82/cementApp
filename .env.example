CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
# Set production and serve public/ through HTTPS for deployment.
# CEMENT_DB_PATH defaults to writable/cement.sqlite; never place it under public/.
CEMENT_DRIVER = local
# MetaForge requires an authenticated compatible API. No automatic local fallback.
# METAFORGE_BASE_URL = 'https://your-metaforge-host/'
# METAFORGE_API_PREFIX = 'api/'
# METAFORGE_PROTOCOL = 'gateway'
# Native uploaded MetaForge: set 'native' after installing the extension.
# Supported native services and remaining modules: docs/NATIVE_METAFORGE.md.
# METAFORGE_CA_BUNDLE = '/absolute/path/to/private-ca-bundle.pem'
# Report generation can run without email. Enable only after configuring CI4 Email securely.
CEMENT_REPORT_EMAIL_ENABLED = 0
# Production: cookie.secure = true
